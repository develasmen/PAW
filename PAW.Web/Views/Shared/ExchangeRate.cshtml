
<div id="exchange-rate-widget" class="exchange-rate-widget">
    <div class="exchange-rate-header">
        <span class="exchange-rate-icon">💱</span>
        <div>
            <h5>Tipo de cambio</h5>
            <small id="exchange-rate-date">Consultando...</small>
        </div>
    </div>

    <div class="exchange-rate-body">
        <div class="exchange-rate-item">
            <span>Compra del dólar</span>
            <strong id="dollar-buy">Cargando...</strong>
        </div>

        <div class="exchange-rate-item">
            <span>Venta del dólar</span>
            <strong id="dollar-sell">Cargando...</strong>
        </div>

        <p id="exchange-rate-status" class="exchange-rate-status">
            Obteniendo datos oficiales...
        </p>
    </div>
</div>

