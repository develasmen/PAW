@model PAW.Models.DTO.NotificationDTO

@{
    ViewData["Title"] = "Edit Notification";
}

<div class="container mt-4">

    <h2>Edit Notification</h2>

    <hr />

    <form asp-action="Edit" method="post">

        <input type="hidden"
               asp-for="Id" />

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">
                User ID
            </label>
            <input asp-for="UserId"
                   class="form-control"
                   type="number" />
            <span asp-validation-for="UserId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Message" class="form-label">
                Message
            </label>
            <textarea asp-for="Message"
                      class="form-control"></textarea>
            <span asp-validation-for="Message"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IsRead" class="form-label">
                Read
            </label>
            <select asp-for="IsRead" class="form-select">
                <option value="">Unknown</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CreatedAt" class="form-label">
                Created Date
            </label>
            <input asp-for="CreatedAt"
                   class="form-control"
                   type="datetime-local" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
