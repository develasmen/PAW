@model PAW.Web.Models.PagedResult<PAW.Models.DTO.CategoryDTO>

@{
    ViewData["Title"] = "Category Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Categories</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Category
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Category ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var category in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @category.CategoryId
                                    </td>

                                    <td>
                                        <strong>@category.CategoryName</strong>
                                    </td>

                                    <td>
                                        @category.Description
                                    </td>

                                    <td>
                                        @category.LastModified?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @category.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@category.CategoryId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- DETAILS -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="showCategoryDetails(@category.CategoryId)">
                                                Details
                                            </button>

                                            <!-- DELETE -->
                                            <form asp-action="Delete"
                                                  method="post"
                                                  style="display:inline"
                                                  onsubmit="return confirm('¿Desea eliminar esta categoría?');">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.CategoryId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6" class="text-center">
                                    No categories found.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINACIÓN -->

            @if (Model != null && Model.TotalPages > 1)
            {
                <nav class="mt-3">

                    <ul class="pagination justify-content-center">

                        <!-- FIRST -->

                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1">
                                &lt;&lt;
                            </a>

                        </li>


                        <!-- PREVIOUS -->

                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                &lt;
                            </a>

                        </li>


                        <!-- PAGE NUMBERS -->

                        @for (int i = Math.Max(1, Model.CurrentPage - 2);
                              i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                              i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i">
                                    @i
                                </a>

                            </li>
                        }


                        <!-- NEXT -->

                        <li class="page-item @(Model.HasNext ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                &gt;
                            </a>

                        </li>


                        <!-- LAST -->

                        <li class="page-item @(Model.HasNext ? "" : "disabled")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@Model.TotalPages">
                                &gt;&gt;
                            </a>

                        </li>

                    </ul>

                </nav>
            }

        </div>

    </div>

</div>


<!-- MODAL DETAILS -->

<div class="modal fade"
     id="categoryDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Category Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body"
                 id="categoryDetailsContent">

                Cargando...

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        function showCategoryDetails(id) {

            fetch('/Category/Details?id=' + id)

                .then(response => response.text())

                .then(html => {

                    document.getElementById('categoryDetailsContent').innerHTML = html;

                    var modal = new bootstrap.Modal(
                        document.getElementById('categoryDetailsModal')
                    );

                    modal.show();

                });

        }

    </script>
}