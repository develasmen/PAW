@model PAW.Models.DTO.UserRoleDTO

@{
    ViewData["Title"] = "Edit User Role";
}

<div class="container mt-4">

    <h2>Edit User Role</h2>

    <hr />

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="UserRoleId" />

        <div class="mb-3">
            <label asp-for="RoleId" class="form-label">Role ID</label>
            <input asp-for="RoleId" class="form-control" type="number" />
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User ID</label>
            <input asp-for="UserId" class="form-control" type="number" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}