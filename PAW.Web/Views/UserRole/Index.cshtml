@model IEnumerable<PAW.Models.DTO.UserRoleDTO>
@{
    ViewData["Title"] = "User Role Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Roles</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add User Role
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User Role ID</th>
                            <th>Role ID</th>
                            <th>User ID</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userRole in Model)
                            {
                                <tr>
                                    <td>@userRole.UserRoleId</td>
                                    <td>@userRole.RoleId</td>
                                    <td>@userRole.UserId</td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@userRole.Id" class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@userRole.Id" class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@userRole.Id" class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">No user roles found.</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>