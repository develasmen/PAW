@model PAW.Models.DTO.InventoryDTO

@{
    ViewData["Title"] = "Edit Inventory";
}

<div class="container mt-4">

    <h2>Edit Inventory</h2>
    <hr />

    <form asp-action="Edit" method="post">

        <input type="hidden"
               asp-for="InventoryId" />

        <div class="mb-3">
            <label asp-for="UnitPrice" class="form-label">
                Unit Price
            </label>
            <input asp-for="UnitPrice"
                   class="form-control"
                   type="number"
                   step="0.01" />
        </div>

        <div class="mb-3">
            <label asp-for="UnitsInStock" class="form-label">
                Units In Stock
            </label>
            <input asp-for="UnitsInStock"
                   class="form-control"
                   type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label">
                Product ID
            </label>
            <input asp-for="ProductId"
                   class="form-control"
                   type="number" />
        </div>

        <div class="mb-3">
            <label asp-for="DateAdded" class="form-label">
                Date Added
            </label>
            <input asp-for="DateAdded"
                   class="form-control"
                   type="datetime-local" />
        </div>

        <div class="mb-3">
            <label asp-for="LastUpdated" class="form-label">
                Last Updated
            </label>
            <input asp-for="LastUpdated"
                   class="form-control"
                   type="datetime-local" />
        </div>

        <div class="mb-3">
            <label asp-for="ModifiedBy" class="form-label">
                Modified By
            </label>
            <input asp-for="ModifiedBy"
                   class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}