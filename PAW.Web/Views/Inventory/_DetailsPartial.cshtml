@model PAW.Models.DTO.InventoryDTO

<div class="row">

    <div class="col-md-4">
        <strong>Inventory ID:</strong>
        @Model.InventoryId
    </div>

    <div class="col-md-4">
        <strong>Unit Price:</strong>
        @(Model.UnitPrice?.ToString("N2") ?? "")
    </div>

    <div class="col-md-4">
        <strong>Units In Stock:</strong>
        @Model.UnitsInStock
    </div>

    <div class="col-md-4 mt-3">
        <strong>Product ID:</strong>
        @Model.ProductId
    </div>

    <div class="col-md-4 mt-3">
        <strong>Date Added:</strong>
        @(Model.DateAdded?.ToString("yyyy-MM-dd HH:mm") ?? "")
    </div>

    <div class="col-md-4 mt-3">
        <strong>Last Updated:</strong>
        @(Model.LastUpdated?.ToString("yyyy-MM-dd HH:mm") ?? "")
    </div>

    <div class="col-md-4 mt-3">
        <strong>Modified By:</strong>
        @Model.ModifiedBy
    </div>

</div>

<hr class="my-4" />

<h5>Associated Products</h5>

<div class="table-responsive mt-3">

    <table class="table table-striped table-hover align-middle">

        <thead class="table-dark">
            <tr>
                <th>Product ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Rating</th>
                <th>Created By</th>
                <th>Modified By</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.ProductId</td>

                        <td>
                            <strong>@product.Name</strong>
                        </td>

                        <td>@product.Description</td>

                        <td>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= product.Rating)
                                {
                                    <span class="text-warning">★</span>
                                }
                                else
                                {
                                    <span class="text-muted">☆</span>
                                }
                            }
                        </td>

                        <td>@product.CreatedBy</td>

                        <td>@product.ModifiedBy</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6"
                        class="text-center">
                        No products associated with this inventory.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>