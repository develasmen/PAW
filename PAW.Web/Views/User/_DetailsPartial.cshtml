@model PAW.Models.DTO.UserDTO

<div class="row">
    <div class="col-md-6"><strong>User ID:</strong> @Model.UserId</div>
    <div class="col-md-6"><strong>Username:</strong> @Model.Username</div>
    <div class="col-md-12 mt-3"><strong>Email:</strong> @Model.Email</div>
    <div class="col-md-6 mt-3"><strong>Role ID:</strong> @Model.RoleId</div>
    <div class="col-md-6 mt-3"><strong>Active:</strong> @(Model.IsActive == true ? "Yes" : Model.IsActive == false ? "No" : "Unknown")</div>
    <div class="col-md-6 mt-3"><strong>Created:</strong> @Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")</div>
    <div class="col-md-6 mt-3"><strong>Last Modified:</strong> @Model.LastModified?.ToString("yyyy-MM-dd HH:mm")</div>
    <div class="col-md-6 mt-3"><strong>Modified By:</strong> @Model.ModifiedBy</div>
</div>
