@model PAW.Web.Models.PagedResult<PAW.Models.DTO.ProductDTO>

@{
    ViewData["Title"] = "Product Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var product in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @product.ProductId
                                    </td>

                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>

                                    <td>
                                        @product.Description
                                    </td>

                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>

                                    <td>
                                        @product.Comments
                                    </td>

                                    <td>
                                        @product.CreatedBy
                                    </td>

                                    <td>
                                        @product.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @product.ModifiedBy
                                    </td>

                                    <td>
                                        @product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="showDetails(@product.ProductId)">
                                                Details
                                            </button>

                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  method="post"
                                                  style="display:inline"
                                                  onsubmit="return confirm('¿Desea eliminar este producto?');">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@product.ProductId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- PAGINACIÓN -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">

                        <!-- FIRST -->
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1">
                                &lt;&lt;
                            </a>
                        </li>

                        <!-- PREVIOUS -->
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                &lt;
                            </a>
                        </li>

                        <!-- NÚMEROS -->
                        @for (int i = Math.Max(1, Model.CurrentPage - 2);
                              i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                              i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i">
                                    @i
                                </a>

                            </li>
                        }

                        <!-- NEXT -->
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                &gt;
                            </a>
                        </li>

                        <!-- LAST -->
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@Model.TotalPages">
                                &gt;&gt;
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>


<!-- MODAL PARA DETAILS -->
<div class="modal fade"
     id="detailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Product Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body"
                 id="detailsContent">

                Cargando...

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        function showDetails(id) {

            fetch('/Product/Details?id=' + id)
                .then(response => response.text())
                .then(html => {

                    document.getElementById('detailsContent').innerHTML = html;

                    var modal = new bootstrap.Modal(
                        document.getElementById('detailsModal')
                    );

                    modal.show();

                });

        }

    </script>
}