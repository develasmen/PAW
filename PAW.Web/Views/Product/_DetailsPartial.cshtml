@model PAW.Models.DTO.ProductDTO

<div class="row">
    <div class="col-md-6">
        <strong>Product ID:</strong>
        @Model.ProductId
    </div>

    <div class="col-md-6">
        <strong>Name:</strong>
        @Model.Name
    </div>

    <div class="col-md-12 mt-2">
        <strong>Description:</strong>
        @Model.Description
    </div>

    <div class="col-md-6 mt-2">
        <strong>Rating:</strong>
        @Model.Rating
    </div>

    <div class="col-md-6 mt-2">
        <strong>Created By:</strong>
        @Model.CreatedBy
    </div>

    <div class="col-md-6 mt-2">
        <strong>Created Date:</strong>
        @Model.CreatedDate
    </div>

    <div class="col-md-6 mt-2">
        <strong>Modified By:</strong>
        @Model.ModifiedBy
    </div>

    <div class="col-md-6 mt-2">
        <strong>Modified Date:</strong>
        @Model.ModifiedDate
    </div>
</div>
