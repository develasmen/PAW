@model PAW.Web.Models.PagedResult<PAW.Models.DTO.ComponentDTO>

@{
    ViewData["Title"] = "Component Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Components</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Component
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Component ID</th>
                            <th>Name</th>
                            <th>Content</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var component in Model.Items)
                            {
                                <tr>
                                    <td>@component.ComponentId</td>

                                    <td>
                                        <strong>@component.Name</strong>
                                    </td>

                                    <td>@component.Content</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Edit"
                                               asp-route-id="@component.ComponentId"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="showDetails(@component.ComponentId)">
                                                Details
                                            </button>

                                            <form asp-action="Delete"
                                                  method="post"
                                                  style="display:inline"
                                                  onsubmit="return confirm('¿Desea eliminar este registro?');">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@component.ComponentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>
                                            </form>

                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">
                                    No components found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model != null && Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1">&laquo;&laquo;</a>
                        </li>

                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">&laquo;</a>
                        </li>

                        @{
                            int windowStart =
                                Math.Max(1, Model.CurrentPage - 1);

                            int windowEnd =
                                Math.Min(Model.TotalPages, Model.CurrentPage + 1);
                        }

                        @if (windowStart > 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }

                        @for (int i = windowStart; i <= windowEnd; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i">@i</a>
                            </li>
                        }

                        @if (windowEnd < Model.TotalPages)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }

                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">&raquo;</a>
                        </li>

                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@Model.TotalPages">&raquo;&raquo;</a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>

<div class="modal fade"
     id="detailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Component Details</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body" id="detailsContent">
                Cargando...
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        function showDetails(id) {
            fetch('/Component/Details?id=' + id)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('detailsContent').innerHTML = html;

                    var modal = new bootstrap.Modal(
                        document.getElementById('detailsModal')
                    );

                    modal.show();
                });
        }
    </script>
}